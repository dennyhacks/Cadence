{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm run setup",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "server/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/billing",
      "schedule": "0 2 * * *"
    }
  ],
  "regions": [
    "hnd1"
  ]
}
