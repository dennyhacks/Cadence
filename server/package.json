{
  "name": "cadence-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "db:migrate": "node db/migrate.js",
    "db:seed": "node db/seed.js",
    "db:seed:volume": "node db/seed-volume.js",
    "db:setup": "node db/migrate.js && node db/seed.js",
    "db:reset": "node db/migrate.js --fresh && node db/seed.js",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "zod": "^4.6.7"
  }
}
