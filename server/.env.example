# Copy this file to .env and fill in your MySQL details.

PORT=4000
CLIENT_URL=http://localhost:5173

# MySQL. A hosting service may give one URL instead: DATABASE_URL=mysql://user:password@host:port/database
# (it takes the place of the DB_* lines below). Hosted databases usually need DB_SSL=true.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=cadence
DB_SSL=false

# Auth. Use a long random string in any real deployment.
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
BCRYPT_ROUNDS=12

# Password reset email. Leave SMTP_HOST empty and the reset link is
# printed in the server console instead (handy for demos and offline work).
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Gmail app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Cadence <no-reply@cadence.local>

# Used by the daily billing job when the host runs it for you (see DEPLOY.md). Any long random string.
CRON_SECRET=

